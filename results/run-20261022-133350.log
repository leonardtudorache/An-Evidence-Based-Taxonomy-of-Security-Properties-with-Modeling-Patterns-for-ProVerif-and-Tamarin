"∃ k m1 m2 #i #j.
  (Valid_sig( k, m1 ) @ #i) ∧ (Valid_sig( k, m2 ) @ #j) ∧ ¬(m1 = m2)"
*/
simplify
solve( !InstancePk( $A, pk(x) ) ▶₀ #i )
  case Instance_Key
  solve( !InstancePk( $A.1, pk(~sk) ) ▶₀ #j )
    case Instance_Key
    solve( !KU( sign(m1, ~sk) ) @ #vk.2 )
      case Sign_Once
      solve( !KU( sign(m2, ~sk) ) @ #vk.5 )
