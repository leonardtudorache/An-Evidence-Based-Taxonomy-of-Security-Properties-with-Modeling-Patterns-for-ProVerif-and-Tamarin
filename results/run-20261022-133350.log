lemma Unforgeability:
  all-traces
  "∀ m pkA #i.
    (ValidSignature( m, pkA ) @ #i) ⇒
    (∃ sk #j. (SignedBy( sk, m ) @ #j) ∧ (pk(sk) = pkA))"
