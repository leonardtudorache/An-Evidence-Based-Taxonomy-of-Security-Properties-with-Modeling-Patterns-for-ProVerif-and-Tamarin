   [ Fr( ~skB ) ] --> [ !LtkB( ~skB ), !PkB( pk(~skB) ), Out( pk(~skB) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Alice_Sender:
   [ Fr( ~x ), Fr( ~m ), !LtkA( ~skA ), !PkB( pkB ) ]
  --[ SignedBy( ~skA, ~m ), Secret( ~m ) ]->
   [
   Out( <senc(~m, h(<'encryption', e(pkB, ~x)>)), h(<~m, e(pkB, ~x)>), 
         signcrypt(~x, h(<~m, e(pkB, ~x)>), ~skA, pkB)>
   ),
   St_Alice_Sent( 'Alice', 'Bob', ~m, h(<~m, e(pkB, ~x)>) )
   ]

  /* has exactly the trivial AC variant */

