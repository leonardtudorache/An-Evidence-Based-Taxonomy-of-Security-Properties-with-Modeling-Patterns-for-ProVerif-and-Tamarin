theory NonEquivocation_SignerSide

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Instance_Key:
   [ Fr( ~sk ) ]
  -->
   [ SigningSlot( $A, ~sk ), !InstancePk( $A, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_Once:
   [ SigningSlot( $A, sk ), In( m ) ] --> [ Out( <m, sign(m, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify:
   [ !InstancePk( $A, k ), In( <m, s> ) ]
  --[ Eq( verify(s, m, k), true ), Valid_sig( k, m ) ]->
   [ ]

