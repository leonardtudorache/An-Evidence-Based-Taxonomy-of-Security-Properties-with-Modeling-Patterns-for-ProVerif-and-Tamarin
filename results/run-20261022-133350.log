  all-traces
  "(∀ a b t #i. (EndI( a, b, t ) @ #i) ⇒ (∃ #j. StartR( b, a, t ) @ #j)) ∧
   (∀ a b t #i. (EndR( b, a, t ) @ #i) ⇒ (∃ #j. StartI( a, b, t ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"((∃ a b t #i.
    (EndI( a, b, t ) @ #i) ∧ ∀ #j. (StartR( b, a, t ) @ #j) ⇒ ⊥) ∨
  (∃ a b t #i.
    (EndR( b, a, t ) @ #i) ∧ ∀ #j. (StartI( a, b, t ) @ #j) ⇒ ⊥))"
