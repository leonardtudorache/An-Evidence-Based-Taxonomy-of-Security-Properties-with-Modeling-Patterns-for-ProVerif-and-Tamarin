lemma in_order_delivery:
  all-traces
  "∀ e1 mi mj #i #j.
    (((Accepted( e1, mi ) @ #i) ∧ (Accepted( e1, mj ) @ #j)) ∧ (#i < #j)) ⇒
    (∃ e2 #k #l.
      ((Send( e2, mi ) @ #k) ∧ (Send( e2, mj ) @ #l)) ∧ (#k < #l))"
/*
guarded formula characterizing all counter-examples:
"∃ e1 mi mj #i #j.
  (Accepted( e1, mi ) @ #i) ∧ (Accepted( e1, mj ) @ #j)
 ∧
  (#i < #j) ∧
  (∀ e2 #k #l. (Send( e2, mi ) @ #k) ∧ (Send( e2, mj ) @ #l) ⇒ ¬(#k < #l))"
*/
simplify
solve( Accepted( e1, mi ) @ #i )
  case Accept_1
  solve( Receiver1( B, A, ~ch ) ▶₀ #i )
    case Open_Channel
    solve( !Pk( $A, pk(x) ) ▶₁ #i )
      case Register_PK
      solve( Accepted( <$B, ~ch>, mj ) @ #j )
        case Accept_1
        solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
          case Open_Channel
          by contradiction /* cyclic */
        qed
      next
        case Accept_2
        solve( Receiver2( $B, A.1, ~ch, x1 ) ▶₀ #j )
          case Accept_1
          solve( !Pk( $A, pk(x) ) ▶₁ #j )
            case Register_PK
            solve( !KU( sign(<~ch, 'start', mi>, ~ltk) ) @ #vk.2 )
              case Send_1
              solve( !KU( sign(<~ch, ~m1, mj>, ~ltk.1) ) @ #vk.5 )
                case Send_2
                by contradiction /* from formulas */
              next
                case c_sign
                by solve( !KU( ~ltk.1 ) @ #vk.8 )
              qed
            next
              case c_sign
              by solve( !KU( ~ltk ) @ #vk.8 )
            qed
          qed
        qed
      next
        case Accept_3
        solve( Receiver3( $B, A.1, ~ch, x2 ) ▶₀ #j )
          case Accept_2
          solve( !Pk( $A, pk(x) ) ▶₁ #j )
            case Register_PK
            solve( !KU( sign(<~ch, 'start', mi>, ~ltk) ) @ #vk.2 )
              case Send_1
              solve( !KU( sign(<~ch, x2, mj>, ~ltk.1) ) @ #vk.5 )
                case Send_1
                solve( !KU( sign(<~ch, ~m1, 'start'>, ~ltk.1) ) @ #vk.5 )
                  case c_sign
                  by solve( !KU( ~ltk.1 ) @ #vk.8 )
                qed
              next
                case Send_2
                by contradiction /* from formulas */
              next
                case Send_3
                by contradiction /* from formulas */
              next
                case c_sign
                by solve( !KU( ~ltk.1 ) @ #vk.11 )
              qed
            next
              case c_sign
              by solve( !KU( ~ltk ) @ #vk.11 )
            qed
          qed
        qed
      qed
    qed
  qed
next
  case Accept_2
  solve( Receiver2( B, A, ~ch, x1 ) ▶₀ #i )
    case Accept_1
    solve( !Pk( $A, pk(x) ) ▶₁ #i )
      case Register_PK
      solve( Accepted( <$B, ~ch>, mj ) @ #j )
        case Accept_1
        solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
          case Open_Channel
          by contradiction /* cyclic */
        qed
      next
        case Accept_2
        solve( Receiver2( $B, A.1, ~ch, x1.1 ) ▶₀ #j )
          case Accept_1
          by contradiction /* cyclic */
        qed
      next
        case Accept_3
        solve( Receiver3( $B, A.1, ~ch, x2 ) ▶₀ #j )
          case Accept_2
          solve( !Pk( $A, pk(x) ) ▶₁ #j )
            case Register_PK
            solve( !KU( sign(<~ch, x1, mi>, ~ltk) ) @ #vk.2 )
              case Send_1
              solve( !KU( sign(<~ch, 'start', 'start'>, ~ltk.2) ) @ #vk.5 )
                case c_sign
                by solve( !KU( ~ltk.2 ) @ #vk.11 )
              qed
            next
              case Send_2
              solve( !KU( sign(<~ch, 'start', ~m1>, ~ltk.2) ) @ #vk.5 )
                case Send_1
                solve( !KU( sign(<~ch, ~m2, mj>, ~ltk.1) ) @ #vk.8 )
                  case Send_3
                  by contradiction /* from formulas */
                next
                  case c_sign
                  by solve( !KU( ~ltk.1 ) @ #vk.11 )
                qed
              next
                case c_sign
                by solve( !KU( ~ltk.2 ) @ #vk.11 )
              qed
            next
              case Send_3
              solve( !KU( sign(<~ch, 'start', ~m2>, ~ltk.2) ) @ #vk.5 )
                case c_sign
                by solve( !KU( ~ltk.2 ) @ #vk.11 )
              qed
            next
              case c_sign
              by solve( !KU( ~ltk ) @ #vk.11 )
            qed
          qed
        qed
      qed
    qed
  qed
next
  case Accept_3
  solve( Receiver3( B, A, ~ch, x2 ) ▶₀ #i )
    case Accept_2
    solve( !Pk( $A, pk(x) ) ▶₁ #i )
      case Register_PK
      solve( Accepted( <$B, ~ch>, mj ) @ #j )
        case Accept_1
        solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
          case Open_Channel
          by contradiction /* cyclic */
        qed
      next
        case Accept_2
        solve( Receiver2( $B, A.1, ~ch, x1 ) ▶₀ #j )
          case Accept_1
          by contradiction /* cyclic */
        qed
      next
        case Accept_3
        solve( Receiver3( $B, A.1, ~ch, x2.1 ) ▶₀ #j )
          case Accept_2
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma uniqueness:
  all-traces
  "∀ e1 m #i #j.
    ((Accepted( e1, m ) @ #i) ∧ (Accepted( e1, m ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ e1 m #i #j.
  (Accepted( e1, m ) @ #i) ∧ (Accepted( e1, m ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Accepted( e1, m ) @ #i )
    case Accept_1
    solve( Receiver1( B, A, ~ch ) ▶₀ #i )
      case Open_Channel
      solve( !Pk( $A, pk(x) ) ▶₁ #i )
        case Register_PK
        solve( Accepted( <$B, ~ch>, m ) @ #j )
          case Accept_1
          solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
            case Open_Channel
            by contradiction /* cyclic */
          qed
        next
          case Accept_2
          solve( Receiver2( $B, A.1, ~ch, x1 ) ▶₀ #j )
            case Accept_1
            solve( !Pk( $A, pk(x) ) ▶₁ #j )
              case Register_PK
              solve( !KU( sign(<~ch, 'start', m>, ~ltk) ) @ #vk.3 )
                case Send_1
                solve( !KU( sign(<~ch, ~m1, ~m1>, ~ltk.1) ) @ #vk.4 )
                  case c_sign
                  by solve( !KU( ~ltk.1 ) @ #vk.7 )
                qed
              next
                case c_sign
                by solve( !KU( ~ltk ) @ #vk.7 )
              qed
            qed
          qed
        next
          case Accept_3
          solve( Receiver3( $B, A.1, ~ch, x2 ) ▶₀ #j )
            case Accept_2
            solve( !Pk( $A, pk(x) ) ▶₁ #j )
              case Register_PK
              solve( !KU( sign(<~ch, 'start', m>, ~ltk) ) @ #vk.3 )
                case Send_1
                solve( !KU( sign(<~ch, x2, ~m1>, ~ltk.1) ) @ #vk.4 )
                  case Send_1
                  solve( !KU( sign(<~ch, ~m1, 'start'>, ~ltk.1) ) @ #vk.5 )
                    case c_sign
                    by solve( !KU( ~ltk.1 ) @ #vk.8 )
                  qed
                next
                  case c_sign
                  by solve( !KU( ~ltk.1 ) @ #vk.10 )
                qed
              next
                case c_sign
                by solve( !KU( ~ltk ) @ #vk.10 )
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Accept_2
    solve( Receiver2( B, A, ~ch, x1 ) ▶₀ #i )
      case Accept_1
      solve( !Pk( $A, pk(x) ) ▶₁ #i )
        case Register_PK
        solve( Accepted( <$B, ~ch>, m ) @ #j )
          case Accept_1
          solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
            case Open_Channel
            by contradiction /* cyclic */
          qed
        next
          case Accept_2
          solve( Receiver2( $B, A.1, ~ch, x1.1 ) ▶₀ #j )
            case Accept_1
            by contradiction /* cyclic */
          qed
        next
          case Accept_3
          solve( Receiver3( $B, A.1, ~ch, x2 ) ▶₀ #j )
            case Accept_2
            solve( !Pk( $A, pk(x) ) ▶₁ #j )
              case Register_PK
              solve( !KU( sign(<~ch, x1, m>, ~ltk) ) @ #vk.3 )
                case Send_1
                solve( !KU( sign(<~ch, 'start', 'start'>, ~ltk.2) ) @ #vk.6 )
                  case c_sign
                  by solve( !KU( ~ltk.2 ) @ #vk.10 )
                qed
              next
                case Send_2
                solve( !KU( sign(<~ch, 'start', ~m1>, ~ltk.2) ) @ #vk.6 )
                  case Send_1
                  solve( !KU( sign(<~ch, ~m2, ~m2>, ~ltk.1) ) @ #vk.7 )
                    case c_sign
                    by solve( !KU( ~ltk.1 ) @ #vk.10 )
                  qed
                next
                  case c_sign
                  by solve( !KU( ~ltk.2 ) @ #vk.10 )
                qed
              next
                case Send_3
                solve( !KU( sign(<~ch, 'start', ~m2>, ~ltk.2) ) @ #vk.6 )
                  case c_sign
                  by solve( !KU( ~ltk.2 ) @ #vk.10 )
                qed
              next
                case c_sign
                by solve( !KU( ~ltk ) @ #vk.10 )
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Accept_3
    solve( Receiver3( B, A, ~ch, x2 ) ▶₀ #i )
      case Accept_2
      solve( !Pk( $A, pk(x) ) ▶₁ #i )
        case Register_PK
        solve( Accepted( <$B, ~ch>, m ) @ #j )
          case Accept_1
          solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
            case Open_Channel
            by contradiction /* cyclic */
          qed
        next
          case Accept_2
          solve( Receiver2( $B, A.1, ~ch, x1 ) ▶₀ #j )
            case Accept_1
            by contradiction /* cyclic */
          qed
        next
          case Accept_3
          solve( Receiver3( $B, A.1, ~ch, x2.1 ) ▶₀ #j )
            case Accept_2
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( Accepted( e1, m ) @ #i )
    case Accept_1
    solve( Receiver1( B, A, ~ch ) ▶₀ #i )
      case Open_Channel
      solve( !Pk( $A, pk(x) ) ▶₁ #i )
        case Register_PK
        solve( Accepted( <$B, ~ch>, m ) @ #j )
