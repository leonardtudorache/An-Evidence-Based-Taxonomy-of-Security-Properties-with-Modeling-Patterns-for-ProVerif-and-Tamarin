          solve( !KU( ~x ) @ #vk.5 )
            case Alice_Sender
            by solve( !KU( ~skA ) @ #vk.6 )
          qed
        qed
      next
        case c_h
        solve( !KU( e(pk(~skB), z) ) @ #vk.7 )
          case c_e
          solve( !KU( signcrypt(z, h(<m, e(pk(~skB), z)>), ~skA, pk(~skB))
                 ) @ #vk.5 )
            case Alice_Sender
            by contradiction /* from formulas */
          next
            case c_signcrypt
            by solve( !KU( ~skA ) @ #vk.10 )
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy:
  all-traces "∀ x #i. (Secret( x ) @ #i) ⇒ (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Secret( x ) @ #i) ∧ ∃ #j. (K( x ) @ #j)"
