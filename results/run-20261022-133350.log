      case Accept_1
      solve( !Pk( $A, pk(x) ) ▶₁ #i )
        case Register_PK
        solve( Accepted( <$B, ~ch>, m ) @ #j )
          case Accept_1
          solve( Receiver1( $B, A.1, ~ch ) ▶₀ #j )
            case Open_Channel
            solve( !KU( sign(<~ch, m, m>, ~ltk) ) @ #vk.3 )
              case c_sign
              by solve( !KU( ~ltk ) @ #vk.7 )
            qed
          qed
        next
          case Accept_2
          solve( Receiver2( $B, A.1, ~ch, x1.1 ) ▶₀ #j )
            case Accept_1
            by contradiction /* cyclic */
          qed
        next
          case Accept_3
          solve( Receiver3( $B, A.1, ~ch, x2 ) ▶₀ #j )
            case Accept_2
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  next
    case Accept_3
