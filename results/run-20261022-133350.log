    2. k     = pk(x.6)
       m     = x.7
       s     = sign(x.7, x.6)
       z     = true
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

lemma non_equivocation:
  all-traces
  "∀ k m1 m2 #i #j.
    ((Valid_sig( k, m1 ) @ #i) ∧ (Valid_sig( k, m2 ) @ #j)) ⇒ (m1 = m2)"
/*
